
# --- TabPFN v3.5-fast (brain/tabpfn_model.py): local and offline, no token needed
CORTEX_TABPFN_DEVICE=auto
CORTEX_TABPFN_N_ESTIMATORS=4

# --- so101 arm planner (so101/config.py)
PLAN_CANDIDATES=2048
PLAN_CEM_ITERS=2
PLAN_MC_SAMPLES=128
USE_POSITION_FEATURES=0       # set 1 on a real table (uneven friction)

# --- TabPFN backend: "cloud" = Prior Labs API (tabpfn_client, fit_with_cache: the server keeps the KV cache), "local" = this GPU
CORTEX_TABPFN_BACKEND=local
TABPFN_TOKEN=                 # cloud only: an API key from https://platform.priorlabs.ai/account/api-keys (never commit it)
